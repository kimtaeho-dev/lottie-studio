{
  "name": "text-to-lottie",
  "productName": "Lottie Studio",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "app": "npm run build && npm run build:electron && electron .",
    "build": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "check:lottie": "node scripts/check-lottie-web-compat.mjs public/projects/*/*/lottie.json",
    "check:motion": "node scripts/check-motion-smoothness.mjs public/projects/*/*/lottie.json",
    "check:text-slots": "node --experimental-strip-types --test scripts/text-slot-unicode.test.mjs",
    "dev": "vite",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "icon": "electron scripts/make-icon.cjs",
    "postinstall": "node scripts/copy-canvaskit.mjs && node scripts/seed-example-projects.mjs",
    "preview": "vite preview",
    "workspace:init": "node scripts/init-workspace.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@kobalte/core": "^0.13.11",
    "@solidjs/router": "^0.16.1",
    "canvaskit-wasm": "^0.41.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "lucide-solid": "^1.18.0",
    "shadcn": "^4.11.0",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-solid-svg": "^0.8.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "solid-devtools": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8"
  },
  "build": {
    "appId": "com.lottiestudio.app",
    "productName": "Lottie Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "CLAUDE.md",
        "to": "seed/CLAUDE.md"
      },
      {
        "from": "README.md",
        "to": "seed/README.md"
      },
      {
        "from": "skills",
        "to": "seed/skills"
      },
      {
        "from": "docs",
        "to": "seed/docs"
      },
      {
        "from": "scripts",
        "to": "seed/scripts"
      },
      {
        "from": "examples",
        "to": "seed/examples"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
